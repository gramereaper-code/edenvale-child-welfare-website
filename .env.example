# Pinocchio Backend -- Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Your Google Gemini API key (get one free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview

# Port for the local backend server (default: 3001)
PORT=3001
